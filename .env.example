# Copy this file to .env and fill in your key. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# LLM_MODEL=claude-haiku-5-5
# WRITER_MODEL=claude-sonnet-5-5
# LLM_EFFORT=medium
# MAX_COST_USD=1.00          # stop a run once it has cost this much

# Optional: tracing with LangSmith (free tier at smith.langchain.com).
# Sends prompts and outputs to LangSmith so you can inspect every step of a run.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=scholar-agent
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your account is in the EU region
